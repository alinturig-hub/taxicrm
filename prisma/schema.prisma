generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum BookingLocationType {
  PICKUP
  DESTINATION
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum BookingTimelineSource {
  AUTOCAB
  SYSTEM
  USER
  AI
}

enum WebhookProcessingMode {
  ALWAYS
  WHEN_CONDITIONS_MATCH
}

enum WebhookConditionMode {
  ALL
  ANY
}

enum WebhookConditionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  EXISTS
  NOT_EXISTS
  GREATER_THAN
  GREATER_THAN_OR_EQUALS
  LESS_THAN
  LESS_THAN_OR_EQUALS
  IN
  NOT_IN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id                String  @id @default(cuid())
  provider          String  @default("AUTOCAB")
  externalId        String
  originalBookingId String?
  bookingType       String?
  typeOfBooking     String?
  status            String  @default("ACTIVE")

  pickupDueTime  DateTime?
  dropOffDueTime DateTime?
  bookedAtTime   DateTime?
  dispatchedAt   DateTime?
  acceptedAt     DateTime?
  arrivedAt      DateTime?
  pickedUpAt     DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  noFareAt       DateTime?

  driverId            String?
  driverCallSign      String?
  driverForename      String?
  driverSurname       String?
  driverBadgeNumber   String?
  vehicleId           String?
  vehicleCallSign     String?
  vehicleRegistration String?
  vehiclePlateNumber  String?

  customerName    String?
  telephoneNumber String?
  customerEmail   String?

  paymentType String?
  accountType String?
  accountId   String?
  accountName String?

  companyId           String?
  companyName         String?
  companyRegisteredNo String?
  companyCode         String?

  priority   Int @default(0)
  passengers Int @default(1)
  luggage    Int @default(0)

  driverNote           String?
  officeNote           String?
  ourReference         String?
  flightDetails        String?
  bookedBy             String?
  bookingSource        String?
  cabExchangeReference String?
  loyaltyCardId        String?
  loyaltyCardCostValue Decimal @default(0) @db.Decimal(12, 2)
  isStreetPickup       Boolean @default(false)

  fare                  Decimal? @db.Decimal(12, 2)
  cost                  Decimal? @db.Decimal(12, 2)
  price                 Decimal? @db.Decimal(12, 2)
  accountAmount         Decimal? @db.Decimal(12, 2)
  cashAmount            Decimal? @db.Decimal(12, 2)
  cardAmount            Decimal? @db.Decimal(12, 2)
  extraCost             Decimal? @db.Decimal(12, 2)
  fixedCost             Decimal? @db.Decimal(12, 2)
  fixedPrice            Decimal? @db.Decimal(12, 2)
  chargingAreaCost      Decimal? @db.Decimal(12, 2)
  chargingAreaPrice     Decimal? @db.Decimal(12, 2)
  waitingTime           Decimal? @db.Decimal(12, 2)
  waitingTimeChargeable Decimal? @db.Decimal(12, 2)
  gratuityAmount        Decimal? @db.Decimal(12, 2)
  costSource            String?
  pricingTariff         String?
  pricingSource         String?

  distance            Decimal? @db.Decimal(12, 3)
  systemDistance      Decimal? @db.Decimal(12, 3)
  meterDistance       Decimal? @db.Decimal(12, 3)
  meterDistanceMetres Int?

  gpsMeterDistance     Decimal? @db.Decimal(12, 3)
  gpsMeterPrice        Decimal? @db.Decimal(12, 2)
  gpsMeterPriceSource  String?
  estimatedDistance    Decimal? @db.Decimal(12, 3)
  estimatedPrice       Decimal? @db.Decimal(12, 2)
  estimatedPriceSource String?
  estimatedTime        String?

  capabilities          Json?
  yourReferences        Json?
  promotionCodeDiscount Json?
  rawPayload            Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations      BookingLocation[]
  vias           BookingVia[]
  webhookEvents  WebhookEvent[]
  timelineEvents BookingTimelineEvent[]
  snapshots      BookingSnapshot[]

  @@unique([provider, externalId])
  @@index([pickupDueTime])
  @@index([telephoneNumber])
  @@index([customerEmail])
  @@index([status])
}

model BookingLocation {
  id             String              @id @default(cuid())
  bookingId      String
  type           BookingLocationType
  address        String
  zoneId         String?
  zoneDescriptor String?
  zoneName       String?
  longitude      Decimal?            @db.Decimal(11, 8)
  latitude       Decimal?            @db.Decimal(10, 8)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([zoneId])
}

model BookingVia {
  id             String   @id @default(cuid())
  bookingId      String
  position       Int
  address        String
  zoneId         String?
  zoneDescriptor String?
  zoneName       String?
  longitude      Decimal? @db.Decimal(11, 8)
  latitude       Decimal? @db.Decimal(10, 8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
}

model AutocabWebhookConfiguration {
  id             String                @id @default(cuid())
  displayName    String
  eventType      String                @unique
  endpointSlug   String                @unique
  description    String?
  isEnabled      Boolean               @default(true)
  processingMode WebhookProcessingMode @default(ALWAYS)
  conditionMode  WebhookConditionMode  @default(ALL)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  conditions    WebhookCondition[]
  webhookEvents WebhookEvent[]

  @@index([isEnabled])
  @@index([endpointSlug])
}

model WebhookCondition {
  id              String                   @id @default(cuid())
  configurationId String
  fieldPath       String
  operator        WebhookConditionOperator
  expectedValue   Json?
  position        Int                      @default(0)
  isEnabled       Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  configuration AutocabWebhookConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId, position])
  @@index([fieldPath])
}

model WebhookEvent {
  id                     String                  @id @default(cuid())
  provider               String                  @default("AUTOCAB")
  eventType              String
  externalBookingId      String?
  idempotencyKey         String                  @unique
  status                 WebhookProcessingStatus @default(RECEIVED)
  payload                Json
  headers                Json?
  processingError        String?
  attemptCount           Int                     @default(0)
  receivedAt             DateTime                @default(now())
  processedAt            DateTime?
  updatedAt              DateTime                @updatedAt
  bookingId              String?
  webhookConfigurationId String?

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  webhookConfiguration AutocabWebhookConfiguration? @relation(fields: [webhookConfigurationId], references: [id], onDelete: SetNull)

  timelineEvents BookingTimelineEvent[]
  snapshots      BookingSnapshot[]

  @@index([provider, eventType])
  @@index([externalBookingId])
  @@index([status])
  @@index([receivedAt])
  @@index([webhookConfigurationId])
}

model BookingTimelineEvent {
  id             String                @id @default(cuid())
  bookingId      String
  webhookEventId String?
  eventType      String
  title          String
  description    String?
  source         BookingTimelineSource @default(AUTOCAB)
  createdBy      String?
  metadata       Json?
  occurredAt     DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@index([bookingId, occurredAt])
  @@index([eventType])
  @@index([source])
  @@index([webhookEventId])
}

model BookingSnapshot {
  id             String   @id @default(cuid())
  bookingId      String
  webhookEventId String?
  version        Int
  eventType      String
  snapshot       Json
  createdAt      DateTime @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@unique([bookingId, version])
  @@unique([webhookEventId])
  @@index([bookingId, createdAt])
  @@index([eventType])
}

enum IntegrationSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum IntegrationSyncEntity {
  DRIVERS
  VEHICLES
  COMPANIES
  ZONES
  CAPABILITIES
}

enum DriverShiftStatus {
  ACTIVE
  ENDED
}

model Driver {
  id         String @id @default(cuid())
  provider   String @default("AUTOCAB")
  externalId String

  rowVersion Int?
  callsign   String?
  forename   String?
  surname    String?
  fullName   String?

  mobile    String?
  telephone String?
  email     String?

  badgeNumber   String?
  licenceNumber String?

  active    Boolean @default(true)
  suspended Boolean @default(false)
  archived  Boolean @default(false)

  companyId      Int?
  shiftPatternId Int?
  fleetOwnerId   Int?

  postalAddressSummary String?

  badgeExpiryDate       DateTime?
  cpcExpiryDate         DateTime?
  dbsExpiryDate         DateTime?
  tachographExpiryDate  DateTime?
  licenceExpiryDate     DateTime?
  insuranceExpiryDate   DateTime?
  medicalCardExpiryDate DateTime?

  capabilities Json?

  lastApiSyncAt    DateTime?
  lastSeenInApiAt  DateTime?
  markedInactiveAt DateTime?
  rawPayload       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts          DriverShift[]
  currentVehicles Vehicle[]         @relation("CurrentVehicleDriver")
  snapshots       VehicleSnapshot[]

  @@unique([provider, externalId])
  @@index([callsign])
  @@index([badgeNumber])
  @@index([licenceNumber])
  @@index([active])
  @@index([suspended])
  @@index([companyId])
  @@index([lastApiSyncAt])
}

model Vehicle {
  id         String @id @default(cuid())
  provider   String @default("AUTOCAB")
  externalId String

  rowVersion Int?
  companyId  Int?
  callsign   String?

  make              String?
  model             String?
  colour            String?
  yearOfManufacture Int?
  vehicleType       String?
  size              Int?

  deviceId     String?
  vinNumber    String?
  plateNumber  String?
  registration String?
  phoneNumber  String?

  isSuspended Boolean @default(false)
  isActive    Boolean @default(true)

  fleetOwnerId        Int?
  ownerDriverId       Int?
  secondOwnerDriverId Int?

  plateExpiryDate     DateTime?
  insuranceExpiryDate DateTime?
  motExpiryDate       DateTime?
  roadTaxExpiryDate   DateTime?

  mileage Int?

  mdtId        Int?
  terminalId   Int?
  terminalType String?
  mdtVersion   String?
  imei         String?
  serial       String?
  simNumber1   String?
  simNumber2   String?

  capabilities Json?
  drivers      Json?
  rawPayload   Json?

  currentDriverId  String?
  currentStatus    String?
  currentBookingId Int?
  currentLatitude  Decimal?  @db.Decimal(10, 7)
  currentLongitude Decimal?  @db.Decimal(10, 7)
  lastSeenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentDriver Driver?           @relation("CurrentVehicleDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)
  shifts        DriverShift[]
  snapshots     VehicleSnapshot[]

  @@unique([provider, externalId])
  @@index([callsign])
  @@index([registration])
  @@index([currentDriverId])
  @@index([currentStatus])
  @@index([currentBookingId])
  @@index([lastSeenAt])
}

model DriverShift {
  id                 String            @id @default(cuid())
  provider           String            @default("AUTOCAB")
  driverId           String
  vehicleId          String?
  status             DriverShiftStatus @default(ACTIVE)
  subEventType       String
  startedAt          DateTime
  endedAt            DateTime?
  modifiedAt         DateTime?
  durationSeconds    Int?
  sourceWebhookEvent String?
  rawPayload         Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  driver  Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([provider, driverId, startedAt])
  @@index([status])
  @@index([startedAt])
  @@index([endedAt])
  @@index([vehicleId])
}

model VehicleSnapshot {
  id              String   @id @default(cuid())
  provider        String   @default("AUTOCAB")
  vehicleId       String
  driverId        String?
  bookingId       Int?
  vehicleStatus   String
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  snapshotAt      DateTime
  receivedAt      DateTime @default(now())
  sourceWebhookId String?
  rawPayload      Json

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId, snapshotAt])
  @@index([driverId, snapshotAt])
  @@index([bookingId])
  @@index([vehicleStatus])
  @@index([snapshotAt])
  @@index([sourceWebhookId])
}

model AutocabApiConfiguration {
  id                   String    @id @default(cuid())
  provider             String    @unique @default("AUTOCAB")
  baseUrl              String    @default("https://autocab-api.azure-api.net")
  apiKeyEncrypted      String?   @db.Text
  apiKeyLastFour       String?
  isEnabled            Boolean   @default(false)
  lastTestedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?   @db.Text

  driverSyncEnabled          Boolean                @default(false)
  driverSyncIntervalMinutes  Int                    @default(1440)
  importActiveDriversOnly    Boolean                @default(true)
  createNewDrivers           Boolean                @default(true)
  updateExistingDrivers      Boolean                @default(true)
  markMissingDriversInactive Boolean                @default(true)
  lastDriverSyncAt           DateTime?
  nextDriverSyncAt           DateTime?
  lastDriverSyncStatus       IntegrationSyncStatus?
  lastDriverSyncMessage      String?                @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
  @@index([driverSyncEnabled, nextDriverSyncAt])
}

model IntegrationSyncJob {
  id       String                @id @default(cuid())
  provider String                @default("AUTOCAB")
  entity   IntegrationSyncEntity
  status   IntegrationSyncStatus @default(RUNNING)
  source   String                @default("MANUAL")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  recordsReceived Int @default(0)
  recordsCreated  Int @default(0)
  recordsUpdated  Int @default(0)
  recordsSkipped  Int @default(0)
  recordsDisabled Int @default(0)
  recordsFailed   Int @default(0)

  message  String? @db.Text
  error    String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, entity, startedAt])
  @@index([status])
  @@index([startedAt])
}

model CompanyDailyMetric {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date

  bookings  Int @default(0)
  completed Int @default(0)
  cancelled Int @default(0)
  noFare    Int @default(0)
  rejected  Int @default(0)

  revenue              Decimal @default(0) @db.Decimal(14, 2)
  cashRevenue          Decimal @default(0) @db.Decimal(14, 2)
  accountRevenue       Decimal @default(0) @db.Decimal(14, 2)
  cardRevenue          Decimal @default(0) @db.Decimal(14, 2)
  estimatedRevenueLost Decimal @default(0) @db.Decimal(14, 2)
  averageBookingValue  Decimal @default(0) @db.Decimal(12, 2)

  completionRate   Decimal @default(0) @db.Decimal(7, 2)
  cancellationRate Decimal @default(0) @db.Decimal(7, 2)
  noFareRate       Decimal @default(0) @db.Decimal(7, 2)
  rejectionRate    Decimal @default(0) @db.Decimal(7, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
